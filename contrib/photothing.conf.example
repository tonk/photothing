# photothing instance configuration. Use it with:  photothing --config=/etc/photothing/familie.conf serve
#
# One "key = value" per line; the keys are the command-line flags. Lines starting with # or ; are comments.
# Relative paths are relative to the directory of this file. Precedence: built-in default < environment
# variable < this file < command-line flag.
# Check what an instance will use with:  photothing --config=/etc/photothing/familie.conf config

# Where the photos are (only ever read) and where photothing keeps its database, key and cache.
photos = /srv/fotos/familie
data   = /var/lib/photothing/familie

# Listen on the loopback address only and let a reverse proxy (nginx) face the internet.
# Every instance needs its own port, its own data directory and its own database.
addr = 127.0.0.1:8081

# The reverse proxy in front of this instance. Its X-Forwarded-For and X-Forwarded-Proto headers are
# believed (so logins are limited per visitor, the audit log shows real addresses, and cookies are
# Secure when the visitor used https). Headers from any other connection are ignored.
# Leave this out when visitors connect directly. Addresses and CIDR ranges, comma separated.
trusted-proxy = 127.0.0.1

# Cookies are marked Secure automatically when the proxy reports https; this forces it.
# secure-cookies = yes

# Look for new, changed, moved and removed photos this often (0 = only at start and from the Admin page).
scan-interval = 10m

# Automatic backups of the database and key (copy them off the machine as well).
backup-dir   = /var/lib/photothing/familie/backups
backup-every = 24h
backup-keep  = 7
