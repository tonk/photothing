# One file per photothing instance, in /etc/nginx/conf.d/ (or in sites-available/, linked into sites-enabled/).
# Adjust the server_name, the certificate paths and the port of the upstream, then:
#     sudo nginx -t && sudo systemctl reload nginx
#
# FIRST install nginx-limits.conf.example once, as /etc/nginx/conf.d/photothing-limits.conf. This file only
# refers to the zone defined there (limit_req zone=photothing_login) and does not define it, so it can be copied
# for every further instance:
#     cp nginx.conf.example /etc/nginx/conf.d/photothing-werk.conf
# and in the copy change exactly four things: the upstream name (photothing_familie, must be unique), its port
# (see addr in that instance's configuration), the server_name and the two certificate paths.
#
# nginx in front of one photothing instance (see config.example: trusted-proxy = 127.0.0.1).

upstream photothing_familie {
    server 127.0.0.1:8081;
    keepalive 8;
}

server {
    listen 80;
    server_name fotos.example.nl;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name fotos.example.nl;

    ssl_certificate     /etc/letsencrypt/live/fotos.example.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fotos.example.nl/privkey.pem;

    # Do not reveal the nginx version.
    server_tokens off;

    # Once https works, tell browsers to insist on it. Be sure before you switch it on: browsers
    # remember it for the whole period, so a certificate that breaks locks visitors out.
    #add_header Strict-Transport-Security "max-age=31536000" always;

    # photothing only receives small forms; photos are never uploaded through it.
    client_max_body_size 1m;

    # These settings apply to every location below.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host              $host;
    # Overwrite (do not append to) the forwarded address. nginx is the first proxy the visitor meets,
    # so $remote_addr is the visitor, and anything the visitor sent in this header is discarded.
    # If nginx itself sits behind another proxy or a CDN, use the realip module to recover the
    # visitor's address first, and list that proxy's addresses with set_real_ip_from.
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The first view of a large photo, HEIC file or video is converted on the spot.
    proxy_read_timeout 120s;

    location = /login {
        # the zone is defined in photothing-limits.conf (see the top of this file)
        limit_req zone=photothing_login burst=10 nodelay;
        proxy_pass http://photothing_familie;
    }

    location / {
        proxy_pass http://photothing_familie;
    }
}
